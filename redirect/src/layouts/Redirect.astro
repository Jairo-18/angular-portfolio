---
/**
 * Respaldo del redirect. Lo normal es que Netlify responda un 301 antes de
 * servir este HTML (ver public/_redirects y ../netlify.toml); si por algo no
 * aplica, la página redirige igual con <meta refresh> + JavaScript,
 * conservando la ruta, la búsqueda y el ancla.
 */
import { TARGET } from '../config';

// En la 404 la ruta real solo la conoce el script; el respaldo va al inicio.
const fallback = Astro.url.pathname.startsWith('/404') ? `${TARGET}/` : `${TARGET}${Astro.url.pathname}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Jhon Jairo Legarda · Me mudé a jairolegarda.tech</title>
    <link rel="canonical" href={TARGET} />
    <meta http-equiv="refresh" content={`0; url=${fallback}`} />
    <script is:inline define:vars={{ TARGET }}>
      const { pathname, search, hash } = window.location;
      const path = pathname.startsWith('/404') ? '/' : pathname;
      window.location.replace(TARGET + path + search + hash);
    </script>
    <style>
      :root {
        color-scheme: dark;
      }
      body {
        margin: 0;
        min-height: 100dvh;
        display: grid;
        place-items: center;
        background: #141a1d;
        color: #e5e7eb;
        font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        text-align: center;
        padding: 1rem;
      }
      a {
        color: #4ade80;
      }
      .brand {
        font-family: ui-monospace, monospace;
        font-weight: 700;
        font-size: 1.5rem;
        color: #22d3ee;
      }
    </style>
  </head>
  <body>
    <main>
      <p class="brand">&lt;/&gt;</p>
      <h1>Mi portafolio ahora está en jairolegarda.tech</h1>
      <p>Si no te redirige solo, <a href={fallback}>entra aquí</a>.</p>
    </main>
  </body>
</html>
